// 학원 문법·독해 영상 학습 사이트 - 데이터 모델
// 구조: Subject(과목: 문법/독해) → Series(교재 시리즈) → Chapter(챕터/권/유닛) → Video(강의 영상)
// 학생(Student)은 아이디+이름을 직접 입력해 로그인하고, Progress로 시청 여부를 기록한다.

generator client {
  provider = "prisma-client-js"
}

// 배포(Vercel) 환경에서는 SQLite 파일이 유지되지 않으므로 Postgres를 사용합니다.
// DATABASE_URL 하나만 있으면 됩니다 (별도의 DIRECT_URL 설정 불필요).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 학생: 아이디 + 이름을 직접 입력해서 로그인 (둘 다 맞아야 입장)
model Student {
  id               String           @id @default(cuid())
  loginId          String           @unique // 학생이 입력하는 "아이디"
  name             String
  grade            String? // 학년 (예: "초5", "중2"), 선택 사항
  school           String? // 학교 이름, 선택 사항
  createdAt        DateTime         @default(now())
  progress         Progress[]
  assignedChapters StudentChapter[] // 관리자가 배정한 챕터(권/유닛) 목록
}

// 학생 ↔ 챕터 배정: 관리자가 "이 학생은 이 권/유닛만 보게" 지정 (시리즈보다 세밀한 단위)
model StudentChapter {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, chapterId])
}

// 과목: "문법 영상" / "독해 지문 영상" 두 가지. 관리자가 추가로 늘릴 수도 있음
model Subject {
  id     String   @id @default(cuid())
  key    String   @unique // "grammar", "reading" 등 URL에 쓰이는 값
  label  String // "문법 영상"
  icon   String   @default("📘") // 목록에 표시할 이모지
  order  Int      @default(0)
  series Series[]
}

// 시리즈: 교재 한 세트 (예: "777 초등영문법", "리더스뱅크2")
model Series {
  id        String    @id @default(cuid())
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  order     Int       @default(0)
  chapters  Chapter[]
}

// 챕터: 시리즈 안의 권/챕터/유닛 (예: "3권", "CH01 be동사와 인칭대명사", "Unit 01")
model Chapter {
  id               String           @id @default(cuid())
  seriesId         String
  series           Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title            String
  order            Int              @default(0)
  videos           Video[]
  assignedStudents StudentChapter[]
}

// 영상: 챕터에 속한 실제 강의 하나
model Video {
  id        String     @id @default(cuid())
  chapterId String
  chapter   Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  page      String? // 교재 페이지, 선택 (예: "p.14")
  order     Int        @default(0) // 챕터 내 순서
  videoUrl  String // 네이버 마이박스/유튜브 등 공유 링크. 비어있으면 "준비 중"
  duration  Int? // 분 단위, 선택
  createdAt DateTime   @default(now())
  progress  Progress[]
}

// 진도: 학생별 영상 시청 여부. 복습해도 최초 시청일은 유지하고 마지막 시청일만 갱신
model Progress {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  videoId        String
  video          Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  watched        Boolean   @default(false)
  firstWatchedAt DateTime?
  lastWatchedAt  DateTime?
  reviewCount    Int       @default(0) // 복습(재시청) 횟수
  watchSeconds   Int? // 시청 완료를 누르기까지 화면에 머문 시간(초). 스킵 방지 참고용

  @@unique([studentId, videoId])
}
